<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>LiteCast</string>
    <key>CFBundleDisplayName</key>
    <string>LiteCast</string>
    <key>CFBundleIdentifier</key>
    <string>com.litecast.app</string>
    <key>CFBundleExecutable</key>
    <string>LiteCast</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.entertainment</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- The site the app shows. Point it at http://localhost:3000 to test local web changes. -->
    <key>LiteCastURL</key>
    <string>https://litecast-zeta.vercel.app</string>
    <!-- Google sign-in happens in the default browser, which hands the result back via litecast:// -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.litecast.app.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>litecast</string>
            </array>
        </dict>
    </array>
    <!-- Some podcast feeds still serve episode audio over plain http -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsForMedia</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
